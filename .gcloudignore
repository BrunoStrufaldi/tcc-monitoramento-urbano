# Arquivos que não vão para a imagem. Isso deixa a imagem menor e evita levar
# segredos e dados locais junto.

.git/
.gitignore
# Pastas ocultas de editor e ferramentas locais (.idea, .vscode etc.)
.*/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/

# Ambientes e dependências que a imagem reinstala do zero
backend/venv/
notificacoes-urbanas/
node_modules/

# Segredos e configuração local. Na nuvem as variáveis vêm do Cloud Run.
backend/.env

# Dados locais. O deploy sobe com o banco vazio.
**/*.db
**/*.db-shm
**/*.db-wal
backend/app/data/
backend/data/

# Arquivos de treino não vão para produção
ml/datasets/
ml/runs/
runs/
weights/

# Testes não rodam dentro da imagem
backend/tests/
frontend/tests/

# Dos modelos, só vão os que o sistema usa.
ml/models/*
!ml/models/yolo11m.pt
!ml/models/gx-veiculos.pt
!ml/models/gx-incident.pt
backend/ml/

# Este arquivo precisa existir: sem ele o gcloud usaria o .gitignore para
# escolher o que enviar.
