# Copie para .env e ajuste os valores
DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/notificacoes_urbanas
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080
# Monitoramento automático (opcional): desligado por padrão, inclusive em
# testes — liga as threads de detecção contínua abaixo. Sem isso, nada roda
# sozinho.
GX_MONITORAMENTO_ATIVO=false

# Detecção contínua de trânsito (opcional): exige backend/requirements-yolo.txt
# instalado. Ativa uma thread que baixa o snapshot da câmera periodicamente
# (GET HTTP) e sinaliza trânsito (contagem de veículos) sem confirmação
# humana — só configure com consentimento de quem opera a câmera. Ex. câmera
# pública CET-SP: https://cameras.cetsp.com.br/Cams/225/1.jpg
GX_CAMERA_SNAPSHOT_URL=
GX_CAMERA_LATITUDE=
GX_CAMERA_LONGITUDE=
GX_LIVE_DETECTION_INTERVAL_SECONDS=5
# Contagem mínima para AVALIAR congestionamento (abaixo nem consulta a TomTom).
GX_TRANSITO_MIN_VEICULOS=12
# Contagem que cria o evento mesmo sem a TomTom confirmar (frame muito cheio).
GX_TRANSITO_MIN_VEICULOS_CONFIRMADO=16
# Na faixa 12..16, índice de congestionamento da TomTom (0-10) necessário para
# criar o evento; abaixo, a TomTom veta (via fluindo, contagem dos dois sentidos).
GX_TRANSITO_TOMTOM_INDICE_MINIMO=3.0
# Piso absoluto de veículos no quadro. Abaixo disto o frame é descartado sem
# nem consultar a TomTom. Entre o piso e GX_TRANSITO_MIN_VEICULOS a contagem
# não cria evento sozinha — quem cria é a TomTom, se corroborar lentidão. É o
# que faz o rush noturno aparecer: o JPEG escuro derruba o score do YOLO e a
# contagem fica em 4..7 numa via que a TomTom mede a 9 km/h.
GX_TRANSITO_MIN_VEICULOS_CORROBORADO=4
GX_ALERTA_COOLDOWN_SECONDS=1800
# Silêncio da câmera depois de um VETO da TomTom (bem menor que o cooldown
# acima, que só vale quando um evento nasce de fato). Também é o teto de
# consumo da TomTom: 1 consulta por câmera a cada 10 min.
GX_TRANSITO_VETO_COOLDOWN_SECONDS=600

# Alternativa/complemento ao snapshot avulso acima: monitora, em paralelo (uma
# thread por câmera, cada uma com seu próprio cooldown), as câmeras públicas
# da CET-SP já cadastradas em app/services/cet_camera_catalog.py — várias
# avenidas reais de São Paulo, não só uma câmera fixa.
GX_TRANSITO_MONITORAR_CATALOGO=false

# Velocidade atual x livre do trecho de via (TomTom Traffic API — cadastro
# gratuito e self-service em developer.tomtom.com, sem convênio institucional).
# Com a chave, a TomTom (1) VETA um evento na faixa GX_TRANSITO_MIN_VEICULOS..
# GX_TRANSITO_MIN_VEICULOS_CONFIRMADO — avenida larga fluindo em que a contagem
# só somou os dois sentidos; (2) CRIA o evento na faixa
# GX_TRANSITO_MIN_VEICULOS_CORROBORADO..GX_TRANSITO_MIN_VEICULOS, onde a
# contagem é baixa demais para se sustentar sozinha (rush noturno); e (3)
# corrobora o score na fusão. Opcional, mas sem a chave a faixa (1) cai na
# decisão só por contagem e a faixa (2) deixa de gerar qualquer evento.
TOMTOM_API_KEY=

# (Havia monitoramento de alagamento/acidente de trânsito via datasets em
# lote do GeoSampa aqui — removido por decisão do grupo: são dados oficiais,
# mas recarregados semanas a anos depois do ocorrido, e cada evento saía
# carimbado com o horário em que o sistema notou o registro, não o horário
# real do incidente. "Tempo real" só ficou valendo pra detecção via câmera
# abaixo. Pelo mesmo motivo, Waze for Cities — exige convênio formal da
# prefeitura com o Google — e o site do CGE — não tem API pública, só
# scraping de HTML frágil — nunca chegaram a entrar.)
#
# O histórico de alagamento por via (CGE-SP/GeoSampa) voltou, mas só como
# camada de referência ESTÁTICA em data_fusion/historico_alagamento.py: um
# prior espacial que a fusão consulta pra calibrar a confiabilidade de um
# alagamento suspeito ("essa via costuma alagar?"). Não é gatilho de detecção
# nem fonte ao vivo — não contradiz o "só tempo real" acima. Sem configuração:
# o arquivo data_fusion/data/pontos_alagamento_sp.json já vai versionado.

# Idade máxima (segundos) que um snapshot de câmera pode ter pra ser tratado
# como "ao vivo" (checa o cabeçalho HTTP Last-Modified). Descoberto na
# prática que a CET às vezes trava numa câmera e devolve sempre o mesmo JPEG
# antigo (200 OK, só o conteúdo é velho) — sem esse limite, isso vira um
# evento "detectado agora" com uma foto de outra hora do dia. Usado por toda
# detecção contínua em câmera (trânsito e alagamento).
GX_CAMERA_FRESCOR_MAXIMO_SEGUNDOS=300

# Peso COCO padrão para contagem de veículos (trânsito). Default: ml/models/yolo11m.pt.
GX_YOLO_MODEL=ml/models/yolo11m.pt

# Resolução de inferência do YOLO de trânsito. 1280 (não os 640 padrão do
# Ultralytics) porque as câmeras da CET acumulam fila de carro pequeno ao
# fundo — em 640 o modelo subconta ~35%. Custo em GPU é de dezenas de ms.
GX_YOLO_IMGSZ=1280

# Modelo dedicado a alagamento (opcional) — pesos próprios, treinados via
# ml/train_incident_model.py, carregados à parte do modelo padrão
# para não perder a contagem de veículos.
GX_YOLO_INCIDENT_MODEL=ml/models/gx-incident.pt

# Confiança mínima só do modelo de incidentes (alagamento), separada da de
# veículos (YOLO_THRESHOLD). Mais alta de propósito: enquanto o peso não é
# retreinado com negativos, ele crava caixa em cena seca com score baixo.
GX_YOLO_INCIDENT_CONF=0.6

# Detecção contínua de alagamento (opcional, exige GX_YOLO_INCIDENT_MODEL
# acima): mesmo padrão do trânsito — uma thread por câmera do catálogo
# (cet_camera_catalog.py), rodando o modelo dedicado direto no snapshot mais
# recente, sem depender de dataset em lote nem confirmação humana.
GX_ALAGAMENTO_MONITORAR_CATALOGO=false
