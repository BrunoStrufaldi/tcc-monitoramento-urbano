# Copie para .env e ajuste os valores
DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/notificacoes_urbanas
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080
# Gere uma chave longa e aleatória fora do repositório (ex.: `openssl rand -hex 32`).
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_MINUTES=60
AUTH_ALLOW_SELF_REGISTRATION=false
# Cria somente o administrador inicial caso ainda não exista.
AUTH_BOOTSTRAP_ADMIN_USERNAME=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# Monitoramento automático (opcional): desligado por padrão, inclusive em
# testes — liga as threads de detecção contínua abaixo. Sem isso, nada roda
# sozinho.
GX_MONITORAMENTO_ATIVO=false

# Detecção contínua de trânsito (opcional): exige backend/requirements-yolo.txt
# instalado. Ativa uma thread que baixa o snapshot da câmera periodicamente
# (GET HTTP) e sinaliza trânsito (contagem de veículos) sem confirmação
# humana — só configure com consentimento de quem opera a câmera. Ex. câmera
# pública CET-SP: https://cameras.cetsp.com.br/Cams/225/1.jpg
GX_CAMERA_SNAPSHOT_URL=
GX_CAMERA_LATITUDE=
GX_CAMERA_LONGITUDE=
GX_LIVE_DETECTION_INTERVAL_SECONDS=5
GX_TRANSITO_MIN_VEICULOS=20
GX_ALERTA_COOLDOWN_SECONDS=1800

# Alternativa/complemento ao snapshot avulso acima: monitora, em paralelo (uma
# thread por câmera, cada uma com seu próprio cooldown), as câmeras públicas
# da CET-SP já cadastradas em app/services/cet_camera_catalog.py — várias
# avenidas reais de São Paulo, não só uma câmera fixa.
GX_TRANSITO_MONITORAR_CATALOGO=false

# Corrobora o índice de congestionamento por contagem de veículos com dado ao
# vivo por trecho de via (TomTom Traffic API — cadastro gratuito e
# self-service em developer.tomtom.com, sem convênio institucional). Opcional:
# sem a chave, o sistema segue funcionando só com a contagem de veículos.
TOMTOM_API_KEY=

# (Havia monitoramento de alagamento/acidente de trânsito via datasets em
# lote do GeoSampa aqui — removido por decisão do grupo: são dados oficiais,
# mas recarregados semanas a anos depois do ocorrido, e cada evento saía
# carimbado com o horário em que o sistema notou o registro, não o horário
# real do incidente. "Tempo real" só ficou valendo pra detecção via câmera
# abaixo. Pelo mesmo motivo, Waze for Cities — exige convênio formal da
# prefeitura com o Google — e o site do CGE — não tem API pública, só
# scraping de HTML frágil — nunca chegaram a entrar.)

# Idade máxima (segundos) que um snapshot de câmera pode ter pra ser tratado
# como "ao vivo" (checa o cabeçalho HTTP Last-Modified). Descoberto na
# prática que a CET às vezes trava numa câmera e devolve sempre o mesmo JPEG
# antigo (200 OK, só o conteúdo é velho) — sem esse limite, isso vira um
# evento "detectado agora" com uma foto de outra hora do dia. Usado por toda
# detecção contínua em câmera (trânsito e alagamento).
GX_CAMERA_FRESCOR_MAXIMO_SEGUNDOS=300

# Modelo dedicado a alagamento (opcional) — pesos próprios, treinados via
# ml/train_incident_model.py, carregados à parte do modelo padrão
# (yolo11n.pt) para não perder a contagem de veículos.
GX_YOLO_INCIDENT_MODEL=ml/models/gx-incident.pt

# Detecção contínua de alagamento (opcional, exige GX_YOLO_INCIDENT_MODEL
# acima): mesmo padrão do trânsito — uma thread por câmera do catálogo
# (cet_camera_catalog.py), rodando o modelo dedicado direto no snapshot mais
# recente, sem depender de dataset em lote nem confirmação humana.
GX_ALAGAMENTO_MONITORAR_CATALOGO=false
