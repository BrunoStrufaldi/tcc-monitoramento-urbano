# Copie para .env e ajuste os valores
DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/notificacoes_urbanas
API_HOST=0.0.0.0
API_PORT=8000
# Só é preciso se o painel for aberto a partir de outro endereço.
CORS_ORIGINS=
# Liga o monitoramento automático das câmeras. Vem desligado por padrão.
GX_MONITORAMENTO_ATIVO=false

# Câmera avulsa para monitorar trânsito (opcional). Precisa do
# backend/requirements-yolo.txt instalado. Exemplo de câmera da CET-SP:
# https://cameras.cetsp.com.br/Cams/225/1.jpg
GX_CAMERA_SNAPSHOT_URL=
GX_CAMERA_LATITUDE=
GX_CAMERA_LONGITUDE=
GX_LIVE_DETECTION_INTERVAL_SECONDS=5
# Quantidade de veículos que já indica trânsito. A TomTom ainda pode recusar
# se a via estiver fluindo.
GX_TRANSITO_MIN_VEICULOS=12
# A partir dessa quantidade o evento é criado sem consultar a TomTom.
GX_TRANSITO_MIN_VEICULOS_CONFIRMADO=16
# Índice mínimo de lentidão da TomTom (0 a 10) para confirmar o trânsito.
GX_TRANSITO_TOMTOM_INDICE_MINIMO=3.0
# Abaixo disso a imagem é ignorada. Entre este valor e GX_TRANSITO_MIN_VEICULOS
# o evento só é criado se a TomTom confirmar a lentidão.
GX_TRANSITO_MIN_VEICULOS_CORROBORADO=4
GX_ALERTA_COOLDOWN_SECONDS=1800
# Tempo de espera depois que a TomTom recusa um evento.
GX_TRANSITO_VETO_COOLDOWN_SECONDS=600

# Monitora o trânsito em todas as câmeras da CET cadastradas no sistema.
GX_TRANSITO_MONITORAR_CATALOGO=false

# Chave da TomTom (cadastro grátis em developer.tomtom.com). É opcional, mas
# sem ela o trânsito é decidido só pela contagem de veículos.
TOMTOM_API_KEY=

# Idade máxima, em segundos, de uma imagem da câmera para ela contar como ao
# vivo. Serve para ignorar câmeras travadas.
GX_CAMERA_FRESCOR_MAXIMO_SEGUNDOS=300

# Modelo de veículos (trânsito).
GX_YOLO_MODEL=ml/models/gx-veiculos.pt

# Tamanho da imagem usado na detecção. Com 640 o YOLO deixava de contar muitos
# carros pequenos ao fundo.
GX_YOLO_IMGSZ=1280

# Modelo de alagamento.
GX_YOLO_INCIDENT_MODEL=ml/models/gx-incident.pt

# Confiança mínima do modelo de alagamento. É mais alta que a de veículos
# porque, abaixo disso, ele confundia pista seca com alagamento.
GX_YOLO_INCIDENT_CONF=0.6

# Monitora alagamento em todas as câmeras da CET cadastradas no sistema.
GX_ALAGAMENTO_MONITORAR_CATALOGO=false
