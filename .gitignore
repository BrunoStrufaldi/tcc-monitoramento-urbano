# automático (cloudbuild.yaml) builda a imagem a partir do GitHub.
ml/models/*.pt
!ml/models/yolo11m.pt
!ml/models/gx-incident.pt
backend/ml/models/*.pt
weights/

# Datasets baixados e runs de treino do modelo de incidentes (grandes, não são código)
ml/datasets/
ml/runs/
runs/

# Bancos SQLite locais
*.db
*.db-shm
*.db-wal

# Dados de runtime (evidências capturadas, logs, backups locais)
